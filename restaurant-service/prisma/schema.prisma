generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["restaurant_service"]
}

model Restaurant {
  id           String        @id @default(uuid())
  name         String
  description  String
  category     String
  address      String
  deliveryTime Int
  deliveryFee  Float
  isOpen       Boolean       @default(true) 
  isFeatured   Boolean       @default(false)
  image        String     
  createdAt    DateTime      @default(now())
  products     Product[]     // 🔗 Conectado con el modelo de abajo
  openingHours OpeningHour[] 

  @@schema("restaurant_service")
}

model OpeningHour {
  id           String     @id @default(uuid())
  dayOfWeek    Int        
  openTime     String     
  closeTime    String     
  
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@schema("restaurant_service") 
}

model Product {
  id           String     @id @default(uuid())
  name         String
  description  String
  price        Float
  category     String     @default("General")
  calories     Int?       
  image        String
  isAvailable  Boolean    @default(true)
  isPopular    Boolean    @default(false) // 🌟 ¡AÑADE ESTA LÍNEA AQUÍ!
  createdAt    DateTime   @default(now())

  // Relación inversa con Restaurante
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@schema("restaurant_service")
}