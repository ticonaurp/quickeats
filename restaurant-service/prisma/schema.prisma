datasource db {
  provider = "postgresql"
  schemas  = ["restaurant_service"] // 🎯 1. Le indicamos a Prisma el territorio exacto en Supabase
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"] // 🎯 2. Activamos la característica para salir de 'public'
}

model Restaurant {
  id           String    @id @default(uuid())
  name         String
  description  String
  category     String
  address      String
  deliveryTime Int
  deliveryFee  Float
  isOpen       Boolean   @default(true)
  isFeatured   Boolean   @default(false)
  image        String    
  createdAt    DateTime  @default(now())
  products     Product[] 

  @@schema("restaurant_service") // 🎯 3. Mapeo explícito para el modelo Restaurant
}

model Product {
  id           String     @id @default(uuid())
  name         String
  description  String?    
  category     String     
  calories     Int?       
  price        Float
  image        String     
  isAvailable  Boolean    @default(true)  
  isPopular    Boolean    @default(false) 
  createdAt    DateTime   @default(now())
  
  // Relaciones
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@schema("restaurant_service") // 🎯 4. Mapeo explícito para el modelo Product
}