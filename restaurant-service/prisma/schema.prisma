datasource db {
  provider = "postgresql" // 
}

generator client {
  provider = "prisma-client-js"
}

model Restaurant {
  id           String    @id @default(uuid())
  name         String
  description  String
  category     String
  address      String
  deliveryTime Int
  deliveryFee  Float
  isOpen       Boolean   @default(true)
  isFeatured   Boolean   @default(false)
  image        String    // Tu campo obligatorio
  createdAt    DateTime  @default(now())
  products     Product[] // Mantén el cascarón de productos para que TS no chille
}

model Product {
  id           String     @id @default(uuid())
  name         String
  description  String
  price        Float
  createdAt    DateTime   @default(now())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}