datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// 1. Definimos los roles oficiales que existirán en QuickEats
enum Role {
  USER
  ADMIN
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER) // 👈 ¡Agrega esto!
  createdAt DateTime @default(now())
}